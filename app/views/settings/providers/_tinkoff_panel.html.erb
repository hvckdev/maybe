<div class="space-y-4">
  <div class="prose prose-sm text-secondary">
    <p class="text-primary font-medium"><%= t("tinkoff_items.panel.setup_instructions") %></p>
    <ol>
      <li><%= t("tinkoff_items.panel.step_1") %></li>
      <li><%= t("tinkoff_items.panel.step_2") %></li>
      <li><%= t("tinkoff_items.panel.step_3") %></li>
      <li><%= t("tinkoff_items.panel.step_4") %></li>
      <li><%= t("tinkoff_items.panel.step_5") %></li>
    </ol>

    <p class="text-primary font-medium"><%= t("tinkoff_items.panel.field_descriptions") %></p>
    <ul>
      <li><strong><%= t("tinkoff_items.panel.fields.session_id.label") %>:</strong> <%= t("tinkoff_items.panel.fields.session_id.description") %> <%= t("tinkoff_items.panel.required") %></li>
    </ul>
  </div>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <div class="p-2 rounded-md bg-destructive/10 text-destructive text-sm overflow-hidden">
      <p class="line-clamp-3" title="<%= error_msg %>"><%= error_msg %></p>
    </div>
  <% end %>

  <%
    tinkoff_item = Current.family.tinkoff_items.first_or_initialize(name: "Tinkoff Connection")
    is_new_record = tinkoff_item.new_record?
  %>

  <%= styled_form_with model: tinkoff_item,
                       url: is_new_record ? tinkoff_items_path : tinkoff_item_path(tinkoff_item),
                       scope: :tinkoff_item,
                       method: is_new_record ? :post : :patch,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :session_id,
                        label: t("tinkoff_items.panel.fields.session_id.label"),
                        placeholder: is_new_record ? t("tinkoff_items.panel.fields.session_id.placeholder_new") : t("tinkoff_items.panel.fields.session_id.placeholder_update"),
                        type: :password %>

    <div class="flex justify-end">
      <%= form.submit is_new_record ? t("tinkoff_items.panel.save_button") : t("tinkoff_items.panel.update_button"),
                      class: "inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium btn btn--primary" %>
    </div>
  <% end %>

  <% items = local_assigns[:tinkoff_items] || @tinkoff_items || Current.family.tinkoff_items.where.not(session_id: [nil, ""]) %>
  <div class="flex items-center gap-2">
    <% if items&.any? %>
      <div class="w-2 h-2 bg-success rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("tinkoff_items.panel.status_configured_html", accounts_path: accounts_path).html_safe %></p>
    <% else %>
      <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("tinkoff_items.panel.status_not_configured") %></p>
    <% end %>
  </div>
</div>
