<%# locals: (planned_expense:, occurrence_count: 1, total_amount: nil) %>

<% occurrence_count ||= 1 %>
<% total_amount ||= planned_expense.amount %>

<%= turbo_frame_tag dom_id(planned_expense) do %>
  <% status_classes = case planned_expense.status
     when "pending" then "bg-blue-100 text-blue-700"
     when "confirmed" then "bg-green-100 text-green-700"
     when "cancelled" then "bg-gray-100 text-gray-500"
     end %>

  <div class="py-2 px-1 group overflow-hidden">
    <%# Row 1: icon + name + actions (mobile: menu, desktop: inline) %>
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
      <%# Category icon %>
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full flex justify-center items-center shrink-0"
           style="background-color: color-mix(in oklab, <%= planned_expense.category.color %> 10%, transparent);
                  color: <%= planned_expense.category.color %>;">
        <% if planned_expense.category.lucide_icon %>
          <%= icon planned_expense.category.lucide_icon, size: "sm", color: "current" %>
        <% else %>
          <%= render DS::FilledIcon.new(variant: :text, hex_color: planned_expense.category.color, text: planned_expense.category.name, size: "md", rounded: true) %>
        <% end %>
      </div>

      <%# Name %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="text-primary text-sm font-medium truncate"><%= planned_expense.name %></span>
          <% if planned_expense.recurring? %>
            <span class="text-xs bg-alpha-black-5 text-secondary px-1.5 py-0.5 rounded shrink-0"><%= planned_expense.recurrence_description %></span>
          <% end %>
          <% if occurrence_count > 1 %>
            <span class="text-xs bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded shrink-0"><%= t("planned_expenses.planned_expense.occurrences_left", count: occurrence_count) %></span>
          <% end %>
        </div>
      </div>

      <%# Desktop: inline action buttons %>
      <% if planned_expense.pending? %>
        <div class="hidden sm:flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
          <%= link_to confirm_budget_planned_expense_path(planned_expense.budget, planned_expense),
                class: "p-1 text-secondary hover:text-primary", title: t("planned_expenses.planned_expense.confirm_title"), data: { turbo_frame: "drawer" } do %>
            <%= icon "check", size: "xs" %>
          <% end %>
          <%= button_to cancel_budget_planned_expense_path(planned_expense.budget, planned_expense),
                method: :post, class: "p-1 text-secondary hover:text-destructive", title: t("planned_expenses.planned_expense.cancel_title") do %>
            <%= icon "x", size: "xs" %>
          <% end %>
          <%= link_to edit_budget_planned_expense_path(planned_expense.budget, planned_expense),
                class: "p-1 text-secondary hover:text-primary", title: t("planned_expenses.edit.title"), data: { turbo_frame: "drawer" } do %>
            <%= icon "pencil-line", size: "xs" %>
          <% end %>
          <%= button_to budget_planned_expense_path(planned_expense.budget, planned_expense),
                method: :delete,
                form: { data: { turbo_confirm: t("planned_expenses.destroy_confirm") } },
                class: "p-1 text-secondary hover:text-destructive", title: t("planned_expenses.planned_expense.delete") do %>
            <%= icon "trash-2", size: "xs" %>
          <% end %>
        </div>
      <% else %>
        <div class="hidden sm:flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
          <%= button_to reopen_budget_planned_expense_path(planned_expense.budget, planned_expense),
                method: :post,
                class: "p-1 text-secondary hover:text-primary", title: t("planned_expenses.planned_expense.reopen") do %>
            <%= icon "rotate-ccw", size: "xs" %>
          <% end %>
          <%= link_to edit_budget_planned_expense_path(planned_expense.budget, planned_expense),
                class: "p-1 text-secondary hover:text-primary", title: t("planned_expenses.edit.title"), data: { turbo_frame: "drawer" } do %>
            <%= icon "pencil-line", size: "xs" %>
          <% end %>
          <%= button_to budget_planned_expense_path(planned_expense.budget, planned_expense),
                method: :delete,
                form: { data: { turbo_confirm: t("planned_expenses.destroy_confirm") } },
                class: "p-1 text-secondary hover:text-destructive", title: t("planned_expenses.planned_expense.delete") do %>
            <%= icon "trash-2", size: "xs" %>
          <% end %>
        </div>
      <% end %>

      <%# Mobile: dropdown menu %>
      <div class="sm:hidden shrink-0 max-w-fit">
        <%= render DS::Menu.new(variant: "icon_sm") do |menu| %>
          <% if planned_expense.pending? %>
            <% menu.with_item(variant: "link", text: t("planned_expenses.planned_expense.confirm"), href: confirm_budget_planned_expense_path(planned_expense.budget, planned_expense), icon: "check", data: { turbo_frame: "drawer" }) %>
            <% menu.with_item(variant: "button", text: t("planned_expenses.planned_expense.cancel"), href: cancel_budget_planned_expense_path(planned_expense.budget, planned_expense), method: :post, icon: "x") %>
          <% else %>
            <% menu.with_item(variant: "button", text: t("planned_expenses.planned_expense.reopen"), href: reopen_budget_planned_expense_path(planned_expense.budget, planned_expense), method: :post, icon: "rotate-ccw") %>
          <% end %>
          <% menu.with_item(variant: "link", text: t("planned_expenses.edit.title"), href: edit_budget_planned_expense_path(planned_expense.budget, planned_expense), icon: "pencil-line", data: { turbo_frame: "drawer" }) %>
          <% menu.with_item(variant: "divider") %>
          <% menu.with_item(variant: "button", text: t("planned_expenses.planned_expense.delete"), href: budget_planned_expense_path(planned_expense.budget, planned_expense), method: :delete, icon: "trash-2", confirm: t("planned_expenses.destroy_confirm")) %>
        <% end %>
      </div>
    </div>

    <%# Row 2: category · account | amount + status %>
    <div class="flex items-center gap-2 mt-1 pl-10 sm:pl-12">
      <div class="flex-1 min-w-0 text-secondary text-xs truncate">
        <%= planned_expense.category.name %>
        <% if planned_expense.account.present? %>
          <span>&middot;</span> <%= planned_expense.account.name %>
        <% end %>
        <% if planned_expense.due_date.present? %>
          <span>&middot;</span> <%= l(planned_expense.due_date, format: :default) %>
        <% end %>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-xs font-medium <%= planned_expense.pending? ? "text-primary" : "text-secondary" %> privacy-sensitive">
          <%= Money.new(total_amount, planned_expense.currency).format %>
        </span>
        <span class="text-xs px-1.5 py-0.5 rounded <%= status_classes %>">
          <%= t("planned_expenses.planned_expense.#{planned_expense.status}") %>
        </span>
      </div>
    </div>
  </div>
<% end %>
