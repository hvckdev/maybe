<%# locals: (planned_expenses:) %>

<%= turbo_frame_tag "planned_expenses_list" do %>
  <% grouped_planned_expenses = PlannedExpense.group_for_display(planned_expenses) %>
  <% if grouped_planned_expenses.any? %>
    <div id="planned-expenses" class="flex flex-col bg-container rounded-xl shadow-border-xs px-3 py-4 lg:p-4">
      <div class="grid grid-cols-12 items-center mb-4 rounded-xl bg-container-inset px-5 py-3 text-xs font-medium uppercase text-secondary">
        <div class="col-span-8 pl-0.5"><p><%= t("transactions.list.transaction") %></p></div>
        <p class="hidden col-span-2 md:block"><%= t("transactions.form.category_label") %></p>
        <p class="col-span-2 col-start-11 justify-self-end md:col-start-auto"><%= t("transactions.show.amount") %></p>
      </div>

      <div class="space-y-6">
        <% grouped_planned_expenses.group_by { |group| group[:planned_expense].due_date || group[:planned_expense].budget.start_date }.sort.each do |date, groups| %>
          <div id="planned-expenses-group-<%= date %>" class="w-full rounded-xl bg-container-inset p-1">
            <div class="flex items-center justify-between px-4 py-2 text-xs font-medium text-secondary">
              <p class="space-x-1.5 uppercase">
                <%= tag.span I18n.l(date, format: :long) %>
                <span>&middot;</span>
                <%= tag.span groups.size %>
              </p>
            </div>

            <div class="rounded-lg bg-container shadow-border-xs">
              <% groups.each do |group| %>
                <%= render "planned_expenses/transaction", planned_expense: group[:planned_expense], occurrence_count: group[:occurrence_count], total_amount: group[:total_amount] %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render DS::EmptyState.new(
      icon: "calendar-clock",
      title: t("planned_expenses.empty.title"),
      description: t("planned_expenses.empty.description")
    ) %>
  <% end %>
<% end %>
