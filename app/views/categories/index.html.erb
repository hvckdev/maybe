<%= content_for :page_title, t(".categories") %>
<%= content_for :page_actions do %>
  <% unless Current.user&.guest? %>
    <% locked = Current.family.categories_locked? %>

    <%# Mobile: dropdown with all actions %>
    <div class="sm:hidden">
      <%= render DS::Menu.new(variant: "icon_sm") do |menu| %>
        <% if Current.user.admin? %>
          <% menu.with_item(
              variant: "button",
              text: locked ? t(".unlock_categories") : t(".lock_categories"),
              href: toggle_lock_categories_path(locked: !locked),
              method: :patch,
              icon: locked ? "lock-open" : "lock") %>
        <% end %>
        <% unless locked %>
          <% menu.with_item(variant: "link", text: t(".new"), href: new_category_path, icon: "plus", data: { turbo_frame: :modal }) %>
        <% end %>
        <% menu.with_item(variant: "link", text: t(".merge"), href: merge_categories_path, icon: "combine", data: { turbo_frame: :modal }) %>
        <% menu.with_item(variant: "divider") %>
        <% menu.with_item(variant: "button", text: t(".delete_all"), href: destroy_all_categories_path, method: :delete, icon: "trash-2", confirm: CustomConfirm.for_resource_deletion("all categories", high_severity: true)) %>
      <% end %>
    </div>

    <%# Desktop: inline buttons %>
    <div class="hidden sm:flex items-center gap-2">
      <%= render DS::Menu.new do |menu| %>
        <% if Current.user.admin? %>
          <% menu.with_item(
              variant: "button",
              text: locked ? t(".unlock_categories") : t(".lock_categories"),
              href: toggle_lock_categories_path(locked: !locked),
              method: :patch,
              icon: locked ? "lock-open" : "lock") %>
        <% end %>
        <% menu.with_item(variant: "button", text: t(".delete_all"), href: destroy_all_categories_path, method: :delete, icon: "trash-2", confirm: CustomConfirm.for_resource_deletion("all categories", high_severity: true)) %>
      <% end %>

      <%= render DS::Link.new(
        text: t(".merge"),
        variant: "outline",
        icon: "combine",
        href: merge_categories_path,
        frame: :modal
      ) %>

      <% unless locked %>
        <%= render DS::Link.new(
          text: t(".new"),
          variant: "primary",
          icon: "plus",
          href: new_category_path,
          frame: :modal
        ) %>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="bg-container rounded-xl shadow-border-xs p-4">
  <% if Current.family.categories_locked? %>
    <div class="mb-4">
      <%= render DS::Alert.new(message: t(".locked_message"), variant: :info) %>
    </div>
  <% end %>

  <% if @categories.any? %>
    <div class="space-y-4">
      <%= render "categories/category_list_group",
                 title: t(".categories"),
                 categories: @categories,
                 family: Current.family,
                 category_groups: @category_groups,
                 category_ids_with_transactions: @category_ids_with_transactions %>
    </div>
  <% else %>
    <div class="flex justify-center items-center py-20">
      <div class="text-center flex flex-col items-center max-w-[500px]">
        <p class="text-sm text-secondary mb-4"><%= t(".empty") %></p>
        <% unless Current.family.categories_locked? || Current.user&.guest? %>
          <div class="flex items-center gap-2">
            <%= render DS::Button.new(
              text: t(".bootstrap"),
              href: bootstrap_categories_path,
            ) %>

            <%= render DS::Link.new(
              text: t(".new"),
              variant: "outline",
              icon: "plus",
              href: new_category_path,
              frame: :modal
            ) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
